# ==============================================================================
# Hermes Autonomous Multi-Repo Orchestrator & Cockpit Configuration
# Copy this file to .env and configure your credentials
# ==============================================================================

# GitHub Personal Access Token (Requires 'repo' and 'project' scopes)
GITHUB_TOKEN=ghp_your_github_token_here

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LLM Local Router / OpenRouter API Key
HERMES_CUSTOM_ANTIGRAVITY_MANAGER_API_KEY=your_openrouter_or_llm_api_key_here
ROUTER_URL=http://127.0.0.1:7836/v1/chat/completions

# Arize Phoenix Observability
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=default
